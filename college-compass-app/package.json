{
  "name": "college-compass-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:ios": "tsc -b && BUILD_TARGET=ios vite build",
    "cap:sync": "npm run build:ios && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "e2e": "bash e2e/run.sh",
    "real-run": "esbuild scripts/real-run.ts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --outfile=.real-run.mjs --log-level=warning && node .real-run.mjs",
    "review-compare": "esbuild scripts/review-compare.ts --bundle --platform=node --format=esm --target=node20 --alias:@=./src --outfile=.review-compare.mjs --log-level=warning && node .review-compare.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
